#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
service="lda-instability-ablations.service"
followup="lda-instability-followup.service"
log_file="$repo_dir/logs/session/instability_ablations.out"

show_status() {
    local state main_pid main_stat run_state result_dir completed total workers
    state="$(systemctl --user show "$service" -p ActiveState --value 2>/dev/null || true)"
    if [[ "$state" != "active" ]]; then
        echo "Instability ablations: ${state:-not installed} ($service)"
        tail -4 "$log_file" 2>/dev/null || true
        return 0
    fi
    main_pid="$(systemctl --user show "$service" -p MainPID --value)"
    main_stat="$(ps -p "$main_pid" -o stat= 2>/dev/null | awk '{print $1}')"
    [[ "$main_stat" == *T* ]] && run_state="paused" || run_state="running"
    workers="$(ps --ppid "$main_pid" -o stat=,pcpu=,cmd= | awk '
        /multiprocessing.spawn/ { n += 1; cpu += $2 }
        END { printf "%d workers, %.0f%% reported CPU", n, cpu }
    ')"
    result_dir="$(awk '/^\/.*results\/instability_ablations\/[0-9_]+$/ { value=$0 } END { print value }' "$log_file" 2>/dev/null)"
    completed=0
    total=50
    if [[ -n "$result_dir" && -f "$result_dir/summary.csv" ]]; then
        completed="$(awk 'END { print (NR > 0 ? NR-1 : 0) }' "$result_dir/summary.csv")"
    fi
    echo "Instability ablations: active/$run_state ($service, main PID $main_pid)"
    echo "Resources: $workers"
    echo "Completed: $completed/$total"
    echo "Results: ${result_dir:-initializing}"
    if [[ -n "$result_dir" && -d "$result_dir" ]]; then
        echo "Recent heartbeats:"
        find "$result_dir" -maxdepth 1 -type f -name '*.log' -printf '%T@ %p\n' \
            | sort -nr | sed -n '1,10p' | while read -r _ run_log; do
                heartbeat="$(grep -E '^\[Fr ' "$run_log" 2>/dev/null | tail -1 || true)"
                printf '  - %s | %s\n' "$(basename "$run_log" .log)" "${heartbeat:-initializing}"
            done
    fi
}

case "${1:-}" in
    start)
        systemctl --user start "$service"
        systemctl --user --no-block start "$followup"
        show_status
        ;;
    status) show_status ;;
    logs)
        touch "$log_file"
        tail -f "$log_file"
        ;;
    pause)
        systemctl --user kill --kill-who=all --signal=SIGSTOP "$service"
        echo "Paused $service in place."
        ;;
    resume)
        systemctl --user kill --kill-who=all --signal=SIGCONT "$service"
        echo "Resumed $service."
        ;;
    stop)
        systemctl --user stop "$service"
        echo "Stopped $service; completed runs remain resumable."
        ;;
    *)
        echo "Usage: scripts/ablationctl {start|status|logs|pause|resume|stop}"
        exit 2
        ;;
esac

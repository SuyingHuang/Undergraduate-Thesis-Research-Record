#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
service="lda-seed-sensitivity.service"
log_file="$repo_dir/logs/session/seed_sensitivity.out"

show_status() {
    local state main_pid main_stat run_state result_dir completed total worker_summary
    state="$(systemctl --user show "$service" -p ActiveState --value 2>/dev/null || true)"
    if [[ "$state" != "active" ]]; then
        echo "Seed sensitivity: ${state:-not installed} ($service)"
        tail -3 "$log_file" 2>/dev/null || true
        return 0
    fi
    main_pid="$(systemctl --user show "$service" -p MainPID --value)"
    main_stat="$(ps -p "$main_pid" -o stat= 2>/dev/null | awk '{print $1}')"
    [[ "$main_stat" == *T* ]] && run_state="paused" || run_state="running"
    worker_summary="$(ps --ppid "$main_pid" -o stat=,pcpu=,cmd= | awk '
        /multiprocessing.spawn/ {
            workers += 1
            if ($1 ~ /T/) paused += 1
            cpu += $2
        }
        END { printf "%d workers (%d paused), %.0f%% reported CPU", workers, paused, cpu }
    ')"
    result_dir="$(awk '/^\/.*results\/seed_sensitivity\/[0-9_]+$/ { value=$0 } END { print value }' "$log_file" 2>/dev/null)"
    completed=0
    total=80
    if [[ -n "$result_dir" && -f "$result_dir/summary.csv" ]]; then
        completed="$(awk 'END { print (NR > 0 ? NR-1 : 0) }' "$result_dir/summary.csv")"
    fi
    echo "Seed sensitivity: active/$run_state ($service, main PID $main_pid)"
    echo "Resources: $worker_summary"
    echo "Completed: $completed/$total"
    echo "Results: ${result_dir:-initializing}"
    if [[ -n "$result_dir" && -d "$result_dir" ]]; then
        echo "Recent run heartbeats:"
        while IFS= read -r record; do
            run_log="${record#* }"
            heartbeat="$(grep -E '^\[Fr ' "$run_log" 2>/dev/null | tail -1 || true)"
            printf '  - %s | %s\n' "$(basename "$run_log" .log)" "${heartbeat:-initializing}"
        done < <(find "$result_dir" -maxdepth 1 -type f -name '*.log' -printf '%T@ %p\n' \
                 | sort -nr | sed -n '1,10p')
    fi
}

usage() {
    cat <<'EOF'
Usage: scripts/seedctl {start|status|watch|logs|pause|resume|stop}

  start    Start the complete 4-case x 20-policy-seed experiment
  status   Show workers, completed runs, result directory, and frame heartbeats
  watch    Refresh status every 15 seconds
  logs     Follow the parent completion log
  pause    Freeze all processes without losing in-memory progress
  resume   Continue a paused experiment
  stop     Stop the experiment; completed runs remain resumable
EOF
}

mkdir -p "$repo_dir/logs/session"

case "${1:-}" in
    start)
        if systemctl --user is-active --quiet "$service"; then
            echo "$service is already active"
        else
            systemctl --user start "$service"
            echo "Started $service"
        fi
        show_status
        ;;
    status)
        show_status
        ;;
    watch)
        while true; do
            printf '\033[H\033[2J'
            date '+%F %T %Z'
            show_status
            echo
            echo "Refreshing every 15 seconds; Ctrl+C only stops viewing."
            sleep 15
        done
        ;;
    logs)
        touch "$log_file"
        tail -f "$log_file"
        ;;
    pause)
        systemctl --user kill --kill-who=all --signal=SIGSTOP "$service"
        echo "Paused $service in place."
        ;;
    resume)
        systemctl --user kill --kill-who=all --signal=SIGCONT "$service"
        echo "Resumed $service."
        ;;
    stop)
        systemctl --user stop "$service"
        echo "Stopped $service; completed per-run files remain on disk."
        ;;
    *)
        usage
        exit 2
        ;;
esac

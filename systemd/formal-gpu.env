# Shared formal-run environment for both the interactive preflight and systemd.
# Keep the interpreter fixed so launching from a shell such as Conda base cannot
# make the preflight and service use different Python installations.
PYTHON_BIN=/home/hp/miniconda3/envs/sagin/bin/python3.11
# Formal sweeps are intentionally pinned to the RTX 4090 that has never
# reported Xid 79.  Keep these values identical: the gate fails closed if the
# process-visible device does not match the expected physical GPU UUID.
CUDA_VISIBLE_DEVICES=GPU-9bd37703-4d1f-1565-6e12-6630229223e5
LDA_EXPECTED_GPU_UUID=GPU-9bd37703-4d1f-1565-6e12-6630229223e5
